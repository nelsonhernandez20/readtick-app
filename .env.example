# Supabase Configuration
# Obtén estos valores en tu panel de control de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Solo servidor: correos que pueden abrir /cobros (no bloquea registro ni login normal)
ADMIN_EMAILS=admin@tu-dominio.com,otro@tu-dominio.com

# Solo servidor: service role para operaciones admin vía API (Project Settings -> API)
# Nunca expongas esta clave en el cliente ni la subas a git
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
